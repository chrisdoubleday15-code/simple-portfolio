---
// Case-study media frame. Pass `videoId` for a Bunny Stream clip, or leave it out
// to render a labelled placeholder for an asset that hasn't been exported yet.
// `loop` autoplays muted on repeat; `autoplay` plays muted once when scrolled into view
// and holds the last frame (clicking replays it).
interface Props {
  videoId?: string;
  label: string;
  aspect?: string;
  loop?: boolean;
  autoplay?: boolean;
}

const { videoId, label, aspect = '16 / 9', loop = false, autoplay = false } = Astro.props;

// player.mediadelivery.net plays inline on iOS; iframe.mediadelivery.net does not.
const src = videoId
  ? loop
    ? `https://player.mediadelivery.net/embed/635173/${videoId}?autoplay=true&loop=true&muted=true&preload=true&responsive=true`
    : autoplay
      ? `https://player.mediadelivery.net/embed/635173/${videoId}?autoplay=false&muted=true&preload=true&responsive=true`
      : `https://player.mediadelivery.net/embed/635173/${videoId}?preload=true&responsive=true`
  : null;
---

<figure class="media-slot" style={`aspect-ratio: ${aspect};`}>
  {src ? (
    <iframe
      src={src}
      data-play-in-view={autoplay && !loop ? '' : undefined}
      loading="lazy"
      title={label}
      allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture"
      allowfullscreen
      style="position:absolute;inset:0;width:100%;height:100%;border:none;"
    ></iframe>
  ) : (
    <figcaption class="media-slot-placeholder">
      <span class="media-slot-tag">Asset needed</span>
      <span>{label}</span>
    </figcaption>
  )}
</figure>

<script>
  // Play-once clips: start each one (via Bunny's player.js API) the first time it is
  // mostly on screen, once its player has reported ready.
  function initPlayInView() {
    const frames = [...document.querySelectorAll<HTMLIFrameElement>('iframe[data-play-in-view]')];
    if (!frames.length) return;
    const state = new Map(frames.map((f) => [f, { ready: false, seen: false, played: false }]));
    const play = (f: HTMLIFrameElement) => {
      const st = state.get(f)!;
      if (!st.ready || !st.seen || st.played) return;
      st.played = true;
      f.contentWindow?.postMessage(JSON.stringify({ context: 'player.js', version: '0.0.11', method: 'play' }), '*');
    };
    window.addEventListener('message', (e) => {
      if (typeof e.data !== 'string' || !e.data.includes('"ready"')) return;
      const f = frames.find((fr) => fr.contentWindow === e.source);
      if (f) { state.get(f)!.ready = true; play(f); }
    });
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (!en.isIntersecting) return;
        const f = en.target as HTMLIFrameElement;
        state.get(f)!.seen = true;
        io.unobserve(f);
        play(f);
      });
    }, { threshold: 0.6 });
    frames.forEach((f) => io.observe(f));
  }
  document.addEventListener('astro:page-load', initPlayInView);
</script>

<style>
  .media-slot {
    position: relative;
    width: 100%;
    margin: 0;
    overflow: hidden;
    border-radius: 3px;
    background: var(--color-bg-surface);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .media-slot-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 1rem;
    text-align: center;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    border: 1px dashed rgba(255, 255, 255, 0.15);
  }
  .media-slot-tag {
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent-blue);
  }
</style>
