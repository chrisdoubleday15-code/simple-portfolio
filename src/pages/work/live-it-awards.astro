---
import Layout from '../../layouts/Layout.astro';
import MediaSlot from '../../components/MediaSlot.astro';

// Same clip as the home case study card.
const HERO_ID  = '9bd37603-d812-4b01-8d94-72ebcfae4efc'; // Live It logo burn (event close loop, 10:3)

const META = [
  { label: 'Client',   value: 'Moxie Pest Control' },
  { label: 'Role',     value: 'Sole motion designer' },
  { label: 'Timeline', value: '6 weeks, incl. render' },
  { label: 'Tools',    value: 'After Effects' },
];

const STATS = [
  { value: '49', label: 'Motion assets delivered' },
  { value: '2.7×', label: 'Output vs. 2025 (18 assets)' },
  { value: '5', label: 'Award templates' },
  { value: '37', label: 'Award animations' },
];

// Screen renders are 5120×1536 (10:3); those run full width so they don't shrink to slivers.
const SCREEN = '10 / 3';

// Award renders, all in the screen format.
const TIERS = [
  { title: '$100k–$250k', videoId: '1fd6be6f-85fd-4928-8099-9a17567e5bea' },
  { title: '$300k–$450k', videoId: 'c8c34576-9fb1-4be1-b051-45142aa7c166' },
  { title: '$500k+',      videoId: 'a833ab9e-7e0c-4944-9486-543c552bd1a1' },
  { title: 'Accounts',    videoId: '34af9a55-7d63-40f7-9fe4-88d2abcff85c' },
];

// Short 16:9 clips of the screens in the room on the night.
const ROOM = [
  { title: 'Logo',   videoId: 'df476d33-94e3-4719-970d-d48bbd01800c' },
  { title: 'Facade', videoId: 'f4a2b401-37b2-4138-b3d2-be4f5775978b' },
  { title: 'Stage',  videoId: '77185fb9-8e54-42ad-9259-0f4704837cd5' },
];

const REPS = [
  { title: 'Rookie of the Year',    videoId: 'de11b1ad-fd7f-49fe-af8f-ddd0e90e007c' },
  { title: 'Sophomore of the Year', videoId: 'f9fa9116-884e-44d1-a0b0-7f1e23795a71' },
  { title: 'Salesman of the Year',  videoId: 'a17b54e7-90c9-4022-aab7-6347e67f00ab' },
];
---

<Layout
  title="Live It Awards 2026 | Christopher Doubleday"
  description="Case study: 49 motion graphics assets for Moxie's Live It Awards 2026, designed solo in six weeks."
  scrollSmooth={true}
>
  <article class="flex flex-col gap-16 py-8">

    <!-- Hero -->
    <header class="flex flex-col gap-6 animate-fade-in">
      <a href="/#motion" class="case-back text-n500 text-xs tracking-widest uppercase self-start">&larr; Back to work</a>
      <div>
        <p class="text-sm tracking-widest uppercase mb-3" style="color: var(--color-accent-blue);">Case Study</p>
        <h1 class="font-display tracking-display text-6xl md:text-8xl text-n200 leading-none">Live It Awards 2026</h1>
        <p class="text-n500 text-lg leading-relaxed mt-6 max-w-2xl">
          A full event package for Moxie's annual awards night: 49 motion graphics assets, up from 18 the year before, designed and delivered solo in six weeks.
        </p>
      </div>
      <MediaSlot videoId={HERO_ID} label="Live It Awards 2026" aspect={SCREEN} loop />
      <dl class="grid grid-cols-2 md:grid-cols-4 gap-6 border-t border-white/5 pt-6">
        {META.map((m) => (
          <div>
            <dt class="text-n500 text-xs tracking-widest uppercase mb-1">{m.label}</dt>
            <dd class="text-n200 text-sm">{m.value}</dd>
          </div>
        ))}
      </dl>
    </header>

    <!-- Brief -->
    <section class="case-section">
      <p class="case-label">The Brief</p>
      <h2 class="case-heading">More than double, same team of one</h2>
      <p class="case-body">
        The 2025 show ran on 18 assets. For 2026, the event needed 49: every award, every stage surface, and the moments that open and close the night. I was the only designer on it, and the six-week window had to include render time for all 49 pieces.
      </p>
    </section>

    <!-- Stats -->
    <section class="grid grid-cols-2 md:grid-cols-4 gap-px bg-white/5 border border-white/5">
      {STATS.map((s) => (
        <div class="flex flex-col gap-2 p-5" style="background: var(--color-bg-base);">
          <span class="font-display tracking-display text-5xl md:text-6xl leading-none" style="color: var(--color-accent-blue);">{s.value}</span>
          <span class="text-n500 text-xs tracking-wide">{s.label}</span>
        </div>
      ))}
    </section>

    <!-- Tier awards (copy TBD) -->
    <section class="case-section">
      <p class="case-label">Tier Awards</p>
      <h2 class="case-heading">Revenue and accounts</h2>
      <div class="flex flex-col gap-6 mt-6">
        {TIERS.map((t) => (
          <div class="flex flex-col gap-2">
            <MediaSlot videoId={t.videoId} label={t.title} aspect={SCREEN} />
            <p class="text-n200 text-sm tracking-wide">{t.title}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Rep of the Year (copy TBD) -->
    <section class="case-section">
      <p class="case-label">Rep of the Year</p>
      <h2 class="case-heading">Rookie, Sophomore, Salesman</h2>
      <div class="flex flex-col gap-6 mt-6">
        {REPS.map((r) => (
          <div class="flex flex-col gap-2">
            <MediaSlot videoId={r.videoId} label={r.title} aspect={SCREEN} />
            <p class="text-n200 text-sm tracking-wide">{r.title}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Visual direction -->
    <section class="case-section">
      <p class="case-label">Visual Direction</p>
      <h2 class="case-heading">A Western theme, carried through all 49</h2>
      <p class="case-body">
        I developed the visual direction around the event's Western theme and held it across every asset, from the stage backgrounds to the award animations, so the night read as one piece instead of 49.
      </p>
      <div class="grid grid-cols-2 gap-3 mt-6">
        <MediaSlot label="Style frame 1" />
        <MediaSlot label="Style frame 2" />
        <MediaSlot label="Style frame 3" />
        <MediaSlot label="Palette + type sheet" />
      </div>
    </section>

    <!-- On the day -->
    <section class="case-section">
      <p class="case-label">On the Night</p>
      <h2 class="case-heading">In the room</h2>
      <div class="flex flex-col gap-6 mt-6">
        {ROOM.map((r) => (
          <MediaSlot videoId={r.videoId} label={r.title} autoplay />
        ))}
      </div>
    </section>

    <!-- Outcome -->
    <section class="case-section">
      <p class="case-label">Outcome</p>
      <h2 class="case-heading">The best one yet</h2>
      <p class="case-body">
        All 49 assets shipped on time. After the event, Moxie's leadership called it the best Live It Awards yet, and the work led directly to my promotion to Senior Motion Designer.
      </p>
      <!-- Founder quote goes here once Jason Walton OKs being quoted by name. -->
    </section>

    <!-- Next -->
    <footer class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 border-t border-white/5 pt-8">
      <a href="/#motion" class="case-back text-n500 text-xs tracking-widest uppercase">&larr; Back to work</a>
      <a href="/contact" class="case-back text-n500 text-xs tracking-widest uppercase">Start a project &rarr;</a>
    </footer>

  </article>
</Layout>

<style>
  .case-section {
    @apply flex flex-col;
  }
  .case-label {
    @apply text-sm tracking-widest uppercase mb-3;
    color: var(--color-accent-blue);
  }
  .case-heading {
    @apply font-display tracking-display text-4xl md:text-5xl text-n200 leading-none;
  }
  .case-body {
    @apply text-n500 leading-relaxed mt-4 max-w-2xl;
  }
  .case-back {
    transition: color 0.2s ease;
  }
  .case-back:hover {
    color: var(--color-accent-blue);
  }
</style>
