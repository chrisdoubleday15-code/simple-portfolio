---
import Layout from '../layouts/Layout.astro';
import ReelsCarousel from '../components/ReelsCarousel.astro';
import WorkOverlay from '../components/WorkOverlay.astro';

const CASE_STUDY_ID = 'e2a9c8f2-1429-4b94-a05c-2ad99da565c3'; // Live It Awards loop

// WorkOverlay's motion lightbox reads these from the grid's data-ids.
const MOTION_IDS = [
  'e2a9c8f2-1429-4b94-a05c-2ad99da565c3',
  '30d66712-7faf-4719-aa57-a094e261e6e3',
  'd588c3c9-8722-46c2-bc98-ce9d412cd237',
  '8ab58885-6eba-4960-965c-46452e78efcc',
];
---

<Layout
  title="Christopher Doubleday | Senior Motion Designer"
  description="Senior motion designer creating bold, high-energy content for brands."
  scrollSmooth={true}
>
  <>
    <!-- ==============================
         HERO — name + tagline only
    ============================== -->
    <section class="text-center relative pt-8 pb-4">
      <div class="relative z-10">

        <div class="hero-clip">
          <p class="hero-word font-sans text-sm tracking-widest uppercase mb-8" style="animation-delay: 0ms; color: var(--color-accent-blue);">
            Senior Motion Designer
          </p>
        </div>

        <h1 class="font-display tracking-display text-7xl md:text-9xl text-n200 leading-none mb-6 flex flex-wrap justify-center gap-x-6">
          <span class="hero-clip"><span class="hero-word" style="animation-delay: 80ms"><span class="hero-letter">C</span><span class="hero-letter">h</span><span class="hero-letter">r</span><span class="hero-letter">i</span><span class="hero-letter">s</span></span></span>
          <span class="hero-clip"><span class="hero-word" style="animation-delay: 200ms"><span class="hero-letter">D</span><span class="hero-letter">o</span><span class="hero-letter">u</span><span class="hero-letter">b</span><span class="hero-letter">l</span><span class="hero-letter">e</span><span class="hero-letter">d</span><span class="hero-letter">a</span><span class="hero-letter">y</span></span></span>
        </h1>
      </div>
    </section>

    <!-- ==============================
         STICKY SECTION NAV
    ============================== -->
    <div class="sticky top-[72px] z-10 border-y border-white/5 backdrop-blur-md" style="background: color-mix(in srgb, var(--color-bg-base) 90%, transparent);">
      <nav class="container flex items-center justify-center gap-6 md:gap-14 py-4">
        <a href="#case-study" class="section-nav-link" data-section="case-study">Case Study</a>
        <a href="#motion"     class="section-nav-link" data-section="motion">Motion</a>
        <a href="#short-form" class="section-nav-link" data-section="short-form">Short Form</a>
        <button              class="section-nav-link" id="nav-work-btn" data-section="work">Editing</button>
      </nav>
    </div>

    <!-- ==============================
         CASE STUDY — Live It Awards 2026
    ============================== -->
    <section id="case-study" class="py-12">
      <div class="mb-6">
        <div class="reveal-clip"><p class="reveal-word text-sm tracking-widest uppercase mb-3" style="--reveal-delay: 0ms; color: var(--color-accent-blue);">Case Study</p></div>
        <div class="reveal-clip"><h2 class="reveal-word font-display tracking-display text-5xl md:text-7xl text-n200" style="--reveal-delay: 120ms">Live It Awards 2026</h2></div>
        <div class="reveal-clip"><p class="reveal-word text-n500 mt-4 max-w-lg" style="--reveal-delay: 220ms">A full event package for Moxie's annual awards night, designed and delivered solo.</p></div>
      </div>

      <a href="/work/live-it-awards" class="case-card glow" aria-label="View the Live It Awards 2026 case study">
        <div class="case-card-media">
          <iframe
            src={`https://player.mediadelivery.net/embed/635173/${CASE_STUDY_ID}?autoplay=true&loop=true&muted=true&preload=true&responsive=true`}
            loading="lazy"
            allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture"
            style="position:absolute;inset:0;width:100%;height:100%;border:none;pointer-events:none;"
            tabindex="-1"
          ></iframe>
        </div>
        <div class="case-card-footer">
          <dl class="case-card-stats">
            <div><dt>49</dt><dd>Assets</dd></div>
            <div><dt>6</dt><dd>Weeks</dd></div>
            <div><dt>1</dt><dd>Designer</dd></div>
          </dl>
          <span class="case-card-cta">View case study &rarr;</span>
        </div>
      </a>
    </section>

    <!-- ==============================
         MOTION DESIGN
    ============================== -->
    <section id="motion" class="py-12 border-t border-white/5">
      <div class="mb-6">
        <div class="reveal-clip"><p class="reveal-word text-sm tracking-widest uppercase mb-3" style="--reveal-delay: 0ms; color: var(--color-accent-blue);">Motion</p></div>
        <div class="reveal-clip"><h2 class="reveal-word font-display tracking-display text-5xl md:text-7xl text-n200" style="--reveal-delay: 120ms">Motion Design</h2></div>
        <div class="reveal-clip"><p class="reveal-word text-n500 mt-4 max-w-lg" style="--reveal-delay: 220ms">Motion graphics and animation for brands.</p></div>
      </div>

      <div class="card-grid editing-grid motion-grid" data-ids={JSON.stringify(MOTION_IDS)}>
        {MOTION_IDS.map((id, i) => (
          <div class="stagger-card" style={`--card-delay: ${i * 80}ms`}>
            <button class="editing-card w-full" data-video-id={id} data-section="motion" aria-label="Play motion clip">
              <iframe
                src={`https://iframe.mediadelivery.net/embed/635173/${id}?preload=true&responsive=true&muted=true&autoplay=false`}
                loading="lazy"
                allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture"
                style="position:absolute;inset:0;width:100%;height:100%;border:none;pointer-events:none;"
                tabindex="-1"
              ></iframe>
              <div class="editing-play">
                <svg viewBox="0 0 24 24" fill="currentColor" width="32" height="32"><path d="M8 5v14l11-7z"/></svg>
              </div>
            </button>
          </div>
        ))}
      </div>
    </section>

    <!-- ==============================
         SHORT FORM — 3D carousel
    ============================== -->
    <section id="short-form" class="py-12 border-t border-white/5">
      <div class="mb-6">
        <div class="reveal-clip"><p class="reveal-word text-sm tracking-widest uppercase mb-3" style="--reveal-delay: 0ms; color: var(--color-accent-blue);">Short Form</p></div>
        <div class="reveal-clip"><h2 class="reveal-word font-display tracking-display text-5xl md:text-7xl text-n200" style="--reveal-delay: 120ms">Short Form</h2></div>
        <div class="reveal-clip"><p class="reveal-word text-n500 mt-4 max-w-lg" style="--reveal-delay: 220ms">Vertical edits for social, from creator teasers to event recaps.</p></div>
      </div>
      <ReelsCarousel />
    </section>

    <WorkOverlay />

    <!-- ==============================
         CONTACT CTA
    ============================== -->
    <section id="contact-cta" class="py-16 border-t border-white/5 text-center">
      <div class="reveal-clip"><p class="reveal-word text-sm tracking-widest uppercase mb-3" style="--reveal-delay: 0ms; color: var(--color-accent-blue);">Contact</p></div>
      <div class="reveal-clip"><h2 class="reveal-word font-display tracking-display text-5xl md:text-7xl text-n200" style="--reveal-delay: 120ms">Let's Work Together</h2></div>
      <div class="reveal-clip"><p class="reveal-word text-n500 mt-4 max-w-lg mx-auto" style="--reveal-delay: 220ms">Have a project that needs motion? I'd like to hear about it.</p></div>
      <a href="/contact" class="cta-btn mt-8">Get in touch</a>
    </section>
  </>
</Layout>

<style>
  /* ── Hero entrance ── */
  .hero-clip {
    overflow: visible;
    display: block;
  }
  h1 .hero-clip {
    display: inline-block;
  }
  .hero-word {
    display: block;
    transform: translateY(110%);
    opacity: 0;
    animation: hero-rise 0.75s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  h1 .hero-word {
    display: inline-block;
  }
  @keyframes hero-rise {
    to { transform: translateY(0); opacity: 1; }
  }

  /* ── Per-letter hover ── */
  .hero-letter {
    display: inline-block;
    overflow: visible;
    color: var(--color-text-primary);
    -webkit-text-stroke: 2px transparent;
    paint-order: stroke fill;
    transition: color 0.15s ease, -webkit-text-stroke-color 0.15s ease;
    cursor: default;
  }
  .hero-letter:hover {
    color: transparent;
    -webkit-text-stroke-color: var(--color-accent-blue);
    text-shadow: 0 0 20px rgba(0, 200, 255, 0.4), 0 0 60px rgba(0, 200, 255, 0.2), 0 0 100px rgba(0, 200, 255, 0.08);
  }

  /* ── Case study card ── */
  .case-card {
    display: block;
    max-width: 56rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 3px;
    overflow: hidden;
    background: var(--color-bg-surface);
    transition: border-color 0.25s ease;
  }
  .case-card:hover {
    border-color: var(--color-accent-blue);
  }
  .case-card-media {
    position: relative;
    aspect-ratio: 16 / 9;
  }
  .case-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .case-card-stats {
    display: flex;
    gap: 1.75rem;
    margin: 0;
  }
  .case-card-stats div {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }
  .case-card-stats dt {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.75rem;
    line-height: 1;
    color: var(--color-accent-blue);
  }
  .case-card-stats dd {
    margin: 0;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .case-card-cta {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-primary);
    white-space: nowrap;
    transition: color 0.2s ease;
  }
  .case-card:hover .case-card-cta {
    color: var(--color-accent-blue);
  }
  @media (max-width: 480px) {
    .case-card-footer { flex-direction: column; align-items: flex-start; }
  }

  /* ── Contact CTA (red per CTA rule) ── */
  .cta-btn {
    display: inline-block;
    padding: 0.85rem 2.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #fff;
    background: var(--color-accent-red);
    transition: opacity 0.2s ease;
  }
  .cta-btn:hover {
    opacity: 0.85;
  }

  /* ── Section nav ── */
  .section-nav-link {
    @apply text-n500 text-xs tracking-widest uppercase transition-colors duration-200 hover:text-n200 py-1;
  }
  .section-nav-link.active {
    color: var(--color-accent-blue);
  }

  /* ── Placeholder pulse ── */
  .placeholder-card, .stagger-card {
    animation: placeholder-pulse 3s ease-in-out infinite;
  }
  @keyframes placeholder-pulse {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.6; }
  }

  /* ── Scroll reveal — headings ── */
  .reveal-clip {
    overflow: hidden;
    display: block;
  }
  .reveal-word {
    display: block;
    transform: translateY(110%);
    opacity: 0;
    transition: transform 0.75s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.75s ease;
    transition-delay: var(--reveal-delay, 0ms);
  }
  .is-visible .reveal-word {
    transform: translateY(0);
    opacity: 1;
  }

  /* ── Scroll reveal — cards ── */
  .stagger-card {
    transform: translateY(24px);
    opacity: 0;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.6s ease;
    transition-delay: var(--card-delay, 0ms);
  }
  .card-grid.is-visible .stagger-card {
    transform: translateY(0);
    opacity: 1;
    animation: none;
  }
</style>

<script>
  function init() {
    // ── Active section nav highlight ──
    const sections = ['case-study', 'motion', 'short-form', 'work', 'contact-cta'];
    const links = document.querySelectorAll('.section-nav-link');

    const navObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            links.forEach((link) => {
              link.classList.toggle(
                'active',
                link.getAttribute('data-section') === entry.target.id
              );
            });
          }
        });
      },
      { rootMargin: '-40% 0px -55% 0px' }
    );

    sections.forEach((id) => {
      const el = document.getElementById(id);
      if (el) navObserver.observe(el);
    });

    // ── Scroll reveal ──
    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px 0px -10% 0px' }
    );

    document.querySelectorAll('#case-study, #motion, #short-form, #contact-cta').forEach((section) => {
      revealObserver.observe(section);
    });

    document.querySelectorAll('.card-grid').forEach((grid) => {
      revealObserver.observe(grid);
    });

    // ── "Work" sticky nav button opens overlay ──
    document.getElementById('nav-work-btn')?.addEventListener('click', () => {
      document.querySelector<HTMLElement>('.work-tab[data-target="0"]')?.click();
    });
  }

  // Run on initial load and after every view transition
  document.addEventListener('astro:page-load', init);
</script>
